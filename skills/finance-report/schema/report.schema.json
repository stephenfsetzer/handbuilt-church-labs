{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handbuilt/finance-report/report.schema.json",
  "title": "Finance report data, shape 1.0",
  "type": "object",
  "required": ["meta", "sources", "short_answer", "cash", "this_month", "plan", "income", "spending",
               "watch", "obligations", "cash_history", "full_years", "pressure"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["report", "meeting_date", "month", "month_name", "through", "months", "status", "prepared"],
      "properties": {
        "month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
        "months": {"type": "integer", "minimum": 1, "maximum": 12},
        "status": {"enum": ["draft", "final"]},
        "approval": {"enum": ["none"]},
        "reconstructed": {"type": "boolean"},
        "previous_report": {"type": "string"}
      }
    },
    "sources": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name", "pulled", "method"]}},
    "short_answer": {"type": "string", "minLength": 20},
    "previous": {"type": "object", "required": ["as_of", "bank", "ytd"]},
    "cash": {"type": "object", "required": ["bank", "as_of", "monthly_spending"],
      "properties": {
        "set_aside": {"type": "array",
          "items": {"type": "object", "required": ["name", "kind", "amount"],
            "properties": {"kind": {"enum": ["restricted", "designated", "investment", "in_transit"]}}}},
        "set_aside_total": {"type": "number"}}},
    "this_month": {"type": "object", "required": ["came_in", "went_out", "top_in", "top_out"]},
    "plan": {
      "type": "object", "required": ["budget", "actual", "unrecorded", "running"],
      "properties": {
        "unrecorded": {"type": "array", "items": {"type": "object", "required": ["amount", "label"]}},
        "running": {"type": "object", "required": ["plan", "last_year", "this_year"],
          "properties": {"plan": {"type": ["array", "null"], "minItems": 12, "maxItems": 12},
                         "last_year": {"type": ["array", "null"], "minItems": 12, "maxItems": 12},
                         "this_year": {"type": "array", "minItems": 1, "maxItems": 12}}}
      }
    },
    "income": {"$ref": "#/$defs/groups"},
    "spending": {"$ref": "#/$defs/groups"},
    "watch": {"type": "array",
      "items": {"type": "object", "required": ["id", "title", "latest", "next"],
        "properties": {"status": {"enum": ["New", "No change", "Better", "Worse", "Resolved"]},
                       "better": {"enum": ["up", "down"]}}}},
    "obligations": {"type": "array", "items": {"type": "object", "required": ["name", "status"]}},
    "cash_history": {"type": "array", "minItems": 2,
      "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "number"}]}},
    "full_years": {"type": "array",
      "items": {"type": "object", "required": ["year", "result", "reported"]}},
    "full_years_note": {"type": "string"},
    "pressure": {"type": ["object", "null"], "required": ["question", "answer", "series"]},
    "short_history": {"type": "boolean"}
  },
  "$defs": {
    "groups": {"type": "object", "required": ["headline", "parts"],
      "properties": {"parts": {"type": "array", "minItems": 2, "maxItems": 5,
        "items": {"type": "object", "required": ["name", "note", "amount"]}}}}
  }
}
